.DS_Store
*.log

# Universal variables: mostly machine/session churn (tide prompt render
# cache) plus absolute paths that don't carry across macOS/Linux.
/fish_variables

# Machine-local overrides: personal paths, account names, per-host settings.
# Tracked template lives at conf.d/99-local.fish.example.
/conf.d/99-local.fish

# Fisher/Tide-managed, reinstalled via `fisher update` from fish_plugins
/completions/
/themes/
/conf.d/_tide_init.fish
/conf.d/fish_frozen_key_bindings.fish
/functions/_tide_*
/functions/tide/
/functions/tide.fish
/functions/fisher.fish
/functions/fish_prompt.fish
/functions/fish_mode_prompt.fish
