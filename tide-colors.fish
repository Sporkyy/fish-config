# Quoin: generated by make gen from the shared palette
# Tide color overrides for use with the Quoin terminal ANSI palette
# Copy as tide-colors.fish into your Fish configuration directory
# Reapply after Tide setup or during interactive startup

if test "$tide_aws_color" != black
    set -U tide_aws_color black
end

if test "$tide_jobs_bg_color" != 2a2f37
    set -U tide_jobs_bg_color 2a2f37
end

if test "$tide_pwd_bg_color" != 263f73
    set -U tide_pwd_bg_color 263f73
end

if test "$tide_python_bg_color" != 2a2f37
    set -U tide_python_bg_color 2a2f37
end

if test "$tide_status_bg_color_failure" != 732632
    set -U tide_status_bg_color_failure 732632
end
